# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.installed.cfg
*.egg
pip-wheel-metadata/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.conda/

# --- Testing / typing / linting caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_convert*

# --- Quarto ---
.quarto/
_book/
_freeze/
site_libs/
**/*.quarto_ipynb

# --- Media (regenerable animations; GIFs/PNGs are kept, .mp4 is not) ---
*.mp4

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
/.quarto/

# ---- Local working material ----
# Scratch space, drafts, and reference material kept alongside the project but
# deliberately outside version control. Contents vary by repo and are not
# reproducible from history -- they're covered by file-level backup instead.
excluded/
