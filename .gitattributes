# Normalise line endings: treat everything as text with LF in the repository,
# letting Git convert to the platform's native endings on checkout. The
# original single-file script was committed with CRLF endings; this ensures a
# consistent LF baseline going forward.
* text=auto eol=lf

# --- Explicit text types ---
*.py    text eol=lf diff=python
*.qmd   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.bib   text eol=lf
*.csv   text eol=lf
*.cfg   text eol=lf
*.txt   text eol=lf

# --- Binary assets (never touch line endings; not diffed) ---
*.png   binary
*.gif   binary
*.mp4   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.pdf   binary

# --- GitHub language statistics: keep the data/ CSVs from skewing the repo's
#     reported language breakdown, and mark generated docs as such. ---
data/*.csv linguist-generated
